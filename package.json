{
  "name": "ecart",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node --max_old_space_size=6096 ./node_modules/@angular/cli/bin/ng serve",
    "build-css": "node-sass src/styles/theme/group1.scss src/assets/group1.css && node-sass src/styles/theme/group2.scss src/assets/group2.css && node-sass src/styles/theme/group3.scss src/assets/group3.css && node-sass src/styles/theme/group4.scss src/assets/group4.css",
    "build": "npm run build-css && node --max_old_space_size=6096 ./node_modules/@angular/cli/bin/ng build",
    "watch": "node --max_old_space_size=6096 ./node_modules/@angular/cli/bin/ng build --watch --configuration development",
    "test": "node --max_old_space_size=6096 ./node_modules/@angular/cli/bin/ng test"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.6",
    "@angular/cdk": "^20.0.5",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/material": "^20.0.5",
    "@angular/material-moment-adapter": "^15.2.9",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.6",
    "@angular/router": "^20.0.0",
    "@material/dialog": "^15.0.0-canary.684e33d25.0",
    "apexcharts": "^4.7.0",
    "bk-angular-table": "^0.0.7",
    "bk-export": "^0.0.12",
    "bootstrap": "^5.3.7",
    "file-saver": "^2.0.5",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.5.29",
    "mat-table-exporter": "^15.0.0",
    "moment": "^2.29.4",
    "ng-apexcharts": "^1.16.0",
    "ngx-cookie-service": "^20.0.1",
    "ngx-extended-pdf-viewer": "^24.0.0",
    "rqp-audit-trail": "^0.0.8",
    "rqp-table": "^0.0.6",
